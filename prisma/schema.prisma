generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum-like values are stored as strings (USER|ADMIN, PENDING|PAID|..., ONE_MONTH|...)
model User {
  id           String     @id @default(cuid())
  email        String?    @unique
  passwordHash String?
  name         String?
  steamId      String?    @unique
  steamName    String?
  avatarUrl    String?
  // Uniqueness is enforced in /api/account/discord/callback
  discordId    String?
  discordName  String?
  stripeCustomerId String?
  role         String     @default("USER")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  orders       Order[]
  reviews      Review[]
  cartItems    CartItem[]

  @@index([discordId])
}

model VipPackage {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  tier        String
  // Tier name RustmaniacVIP understands: "vip", "vip+" or "vip++"
  grantTier   String      @default("vip")
  description String
  features    String
  kitContents String      @default("[]")
  priceMonth  Int
  priceThree  Int
  pricePerm   Int
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  cartItems   CartItem[]
  orderItems  OrderItem[]
}

model Plugin {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  priceCents  Int
  version     String      @default("1.0.0")
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  cartItems   CartItem[]
  orderItems  OrderItem[]
}

model Staff {
  id        String   @id @default(cuid())
  name      String
  role      String
  steamId   String?
  avatarUrl String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rule {
  id        String   @id @default(cuid())
  category  String
  title     String
  body      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  pinned    Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  userId    String?
  author    String
  rating    Int
  body      String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
}

model CartItem {
  id           String      @id @default(cuid())
  userId       String
  kind         String
  vipPackageId String?
  pluginId     String?
  duration     String?
  quantity     Int         @default(1)
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vipPackage   VipPackage? @relation(fields: [vipPackageId], references: [id])
  plugin       Plugin?     @relation(fields: [pluginId], references: [id])

  @@index([userId])
}

model Order {
  id                  String      @id @default(cuid())
  userId              String?
  email               String
  status              String      @default("PENDING")
  totalCents          Int
  currency            String      @default("usd")
  stripeSessionId     String?     @unique
  stripePaymentIntent String?
  stripeInvoiceId     String?
  invoiceUrl          String?
  invoicePdf          String?
  displayName         String?
  steamId             String?
  fulfilledAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  user                User?       @relation(fields: [userId], references: [id])
  items               OrderItem[]
  deliveries          Delivery[]
}

// In-game grants waiting for the RustmaniacStore Oxide plugin to pick up.
model Delivery {
  id          String    @id @default(cuid())
  orderId     String
  steamId     String
  tier        String
  // null = permanent
  days        Int?
  status      String    @default("PENDING") // PENDING | DELIVERED | FAILED
  attempts    Int       @default(0)
  result      String?
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Steam <-> Discord links made in game with /link (RustmaniacDiscord), synced by RustmaniacStore.
model DiscordLink {
  steamId     String   @id
  discordId   String
  discordName String?
  updatedAt   DateTime @updatedAt
}

// Single row (id "main") pushed by the RustmaniacStore Oxide plugin.
model ServerStatus {
  id         String    @id
  hostname   String
  online     Int
  maxPlayers Int
  sleepers   Int
  queued     Int
  joining    Int
  worldSize  Int
  seed       Int
  wipedAt    DateTime?
  nextWipe   DateTime?
  updatedAt  DateTime  @updatedAt
}

model OrderItem {
  id           String      @id @default(cuid())
  orderId      String
  kind         String
  name         String
  duration     String?
  unitCents    Int
  quantity     Int         @default(1)
  vipPackageId String?
  pluginId     String?
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vipPackage   VipPackage? @relation(fields: [vipPackageId], references: [id])
  plugin       Plugin?     @relation(fields: [pluginId], references: [id])

  @@index([orderId])
}

model RateLimitBucket {
  id        String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}
