# Database (SQLite for local demo; swap to Postgres in production)
DATABASE_URL="file:./dev.db"
# Postgres example:
# DATABASE_URL="postgresql://user:pass@localhost:5432/rustmaniac"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string"

# Steam OpenID (https://steamcommunity.com/dev/apikey)
# Without this key, Steam login shows a setup message instead of authenticating.
STEAM_API_KEY=""

# Stripe Checkout + webhooks
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Public site URL (used in Stripe success/cancel redirects)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seeded admin account (prisma/seed.ts)
ADMIN_EMAIL="admin@rustmaniac.local"
ADMIN_PASSWORD="admin123!"
