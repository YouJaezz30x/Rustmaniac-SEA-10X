# Postgres (Neon). Use the pooled connection string from the Neon dashboard.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string"

# Public site URL (Steam/Discord/Stripe redirects)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Leave unset (or "false") to keep the site out of search engines until launch.
SITE_PUBLIC="false"

# Game server
NEXT_PUBLIC_SERVER_ADDRESS="51.79.214.144:21066"
# Shared secret for the RustmaniacStore Oxide plugin (at least 32 characters). Put the same value
# in oxide/config/RustmaniacStore.json on the game server.
SERVER_API_KEY=""

# Steam sign-in works without a key; the key adds Steam names and avatars.
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=""

# Discord account linking (Discord Developer Portal -> your app -> OAuth2).
# Add redirect: <site>/api/account/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Staff channel webhook for purchase and failed-delivery alerts.
DISCORD_PURCHASE_WEBHOOK_URL=""

# Stripe Checkout + webhooks (webhook endpoint: <site>/api/webhooks/stripe,
# events: checkout.session.completed, checkout.session.async_payment_succeeded)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Prices in the admin panel are in the smallest unit of this currency (cents/centavos).
NEXT_PUBLIC_STORE_CURRENCY="usd"

# First admin account, created by `npm run db:seed` if it doesn't exist yet.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
